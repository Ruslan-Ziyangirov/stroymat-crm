# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ключ для интеграции с 1С (передаётся в заголовке x-api-key)
INTEGRATION_1C_API_KEY=change-me-super-secret

# Публичный адрес приложения
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Необязательно: прямой доступ к Postgres для применения миграций скриптом
# (scripts/apply-migration.ts) вместо ручной вставки в Supabase SQL Editor.
# Берётся в Project Settings → Database → Connection pooling → Session pooler
# (обычное прямое подключение на 5432 часто недоступно — у Supabase оно на IPv6).
# DATABASE_URL=postgresql://postgres.your-project:your-db-password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
